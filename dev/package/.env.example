# --- REQUIRED ---
CREDENTIAL_ENCRYPTION_KEY=   # 64 hex chars. LOSE THIS = encrypted secrets unrecoverable. Reuse existing to keep data.
DAM_PG_PASSWORD=
DAM_CLICKHOUSE_PASSWORD=
DAM_JWT_SECRET=
DOMAIN=dam.example.com                 # tenant console — Caddy auto-provisions TLS for this name
ADMIN_DOMAIN=admin-dam.example.com     # super-admin console — its own subdomain (+ its own TLS cert)
APP_BASE_URL=https://dam.example.com
API_PUBLIC_URL=https://dam.example.com
# --- optional (SSO / SMTP / KMS / payments) leave blank if unused ---
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
