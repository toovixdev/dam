# TooVix DAM Agent configuration — Solaris / illumos.
# Copy to /etc/toovix/agent.env and edit; the SMF service (dam-agent.smf.xml) sources it.
#
# On Solaris, eBPF (host) and AF_PACKET (network) capture are unavailable. Use one of:
#   proxy         — clients connect THROUGH the agent; sees every statement, can block.
#   audit-forward — tail MySQL's native audit log (AgentLite); no client reconfiguration.

# --- MySQL, proxy mode (recommended where you can repoint clients) ---
MODE=proxy
DB_ENGINE=mysql
TARGET_HOST=127.0.0.1
TARGET_PORT=3306
# LISTEN_PORT must be free and (on the DB host itself) MUST NOT equal the DB's own port.
LISTEN_PORT=3307
UPSTREAM=127.0.0.1:3306

# --- OR MySQL, audit-forward mode (no client changes; needs the MySQL audit log enabled) ---
#MODE=audit-forward
#DB_ENGINE=mysql
#TARGET_HOST=127.0.0.1
#TARGET_PORT=3306
#AUDIT_SOURCE=/var/log/mysql/audit.log

# Enrollment (from the DAM console → Deploy Monitoring)
AGENT_ENROLL_TOKEN=<enroll-token-from-Deploy-Monitoring>
CONTROL_PLANE=https://dam.example.com

# --- optional: schema classification (any mode) ---
#CLASSIFY=true
#DB_USER=dam_svc
#DB_PASSWORD=<db-reader-password>
