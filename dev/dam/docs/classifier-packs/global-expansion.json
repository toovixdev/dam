{
  "pack": "Global classification expansion",
  "note": "Additional sensitive-data detectors (national IDs, PHI codes, financial identifiers) loaded via the bulk-import pipeline (Admin → Content Packs → Detectors → Import). Extends the built-in seed; upserts by detector_id, curation preserved.",
  "detectors": [
    { "detector_id": "ca-sin", "tag": "gov_id", "label": "Canada Social Insurance Number", "category": "PII", "sensitivity": "critical", "name_regex": "\\bsin\\b|social_insurance", "content_kind": "regex", "content_regex": "^\\d{3}-?\\d{3}-?\\d{3}$", "threshold": 0.6, "region": "any" },
