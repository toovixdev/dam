{
  "pack": "CIS PostgreSQL core (toward full automatable coverage)",
  "checks": [
    { "engine":"postgresql","check_id":"pg-log-destination","benchmark":"CIS PostgreSQL","section":"3.1.x","title":"log_destination is set","severity":"low","query":"SHOW log_destination","expect":{"op":"notEmpty"},"remediation":"Set log_destination (e.g. stderr,csvlog).","refs":["CIS PostgreSQL §3.1"] },
    { "engine":"postgresql","check_id":"pg-log-truncate-on-rotation","benchmark":"CIS PostgreSQL","section":"3.1.x","title":"log_truncate_on_rotation is on","severity":"low","query":"SHOW log_truncate_on_rotation","expect":{"op":"equals","value":"on"},"remediation":"Set log_truncate_on_rotation=on.","refs":["CIS PostgreSQL §3.1"] },
    { "engine":"postgresql","check_id":"pg-log-checkpoints","benchmark":"CIS PostgreSQL","section":"3.1.x","title":"log_checkpoints is on","severity":"low","query":"SHOW log_checkpoints","expect":{"op":"equals","value":"on"},"remediation":"Set log_checkpoints=on.","refs":["CIS PostgreSQL §3.1"] },
    { "engine":"postgresql","check_id":"pg-log-lock-waits","benchmark":"CIS PostgreSQL","section":"3.1.x","title":"log_lock_waits is on","severity":"low","query":"SHOW log_lock_waits","expect":{"op":"equals","value":"on"},"remediation":"Set log_lock_waits=on.","refs":["CIS PostgreSQL §3.1"] },
    { "engine":"postgresql","check_id":"pg-log-min-error-statement","benchmark":"CIS PostgreSQL","section":"3.1.x","title":"log_min_error_statement is 'error' or stricter","severity":"low","query":"SHOW log_min_error_statement","expect":{"op":"equals","value":"error"},"remediation":"Set log_min_error_statement=error.","refs":["CIS PostgreSQL §3.1"] },
    { "engine":"postgresql","check_id":"pg-log-temp-files","benchmark":"CIS PostgreSQL","section":"3.1.x","title":"log_temp_files is enabled (not -1)","severity":"low","query":"SHOW log_temp_files","expect":{"op":"notEquals","value":"-1"},"remediation":"Set log_temp_files=0 to log all temp files.","refs":["CIS PostgreSQL §3.1"] },
    { "engine":"postgresql","check_id":"pg-ssl-ciphers","benchmark":"CIS PostgreSQL","section":"6.x","title":"ssl_ciphers restricts to HIGH","severity":"medium","query":"SHOW ssl_ciphers","expect":{"op":"contains","value":"HIGH"},"remediation":"Set ssl_ciphers='HIGH:!aNULL' (or stronger).","refs":["CIS PostgreSQL §6"] },
    { "engine":"postgresql","check_id":"pg-ssl-prefer-server-ciphers","benchmark":"CIS PostgreSQL","section":"6.x","title":"ssl_prefer_server_ciphers is on","severity":"low","query":"SHOW ssl_prefer_server_ciphers","expect":{"op":"equals","value":"on"},"remediation":"Set ssl_prefer_server_ciphers=on.","refs":["CIS PostgreSQL §6"] },
    { "engine":"postgresql","check_id":"pg-track-activities","benchmark":"CIS PostgreSQL","section":"8.x","title":"track_activities is on","severity":"low","query":"SHOW track_activities","expect":{"op":"equals","value":"on"},"remediation":"Set track_activities=on.","refs":["CIS PostgreSQL §8"] },
    { "engine":"postgresql","check_id":"pg-track-counts","benchmark":"CIS PostgreSQL","section":"8.x","title":"track_counts is on","severity":"low","query":"SHOW track_counts","expect":{"op":"equals","value":"on"},"remediation":"Set track_counts=on (needed by autovacuum).","refs":["CIS PostgreSQL §8"] },
    { "engine":"postgresql","check_id":"pg-data-checksums","benchmark":"CIS PostgreSQL","section":"x","title":"Data checksums are enabled","severity":"low","query":"SHOW data_checksums","expect":{"op":"equals","value":"on"},"remediation":"Initialize the cluster with --data-checksums (or enable offline) for corruption detection.","refs":["CIS PostgreSQL"] },
    { "engine":"postgresql","check_id":"pg-shared-preload-pgaudit","benchmark":"CIS PostgreSQL","section":"3.2","title":"pgAudit is in shared_preload_libraries","severity":"medium","query":"SHOW shared_preload_libraries","expect":{"op":"contains","value":"pgaudit"},"remediation":"Add pgaudit to shared_preload_libraries and CREATE EXTENSION pgaudit.","refs":["CIS PostgreSQL §3.2","PCI-DSS 10.2"] },
    { "engine":"postgresql","check_id":"pg-replication-role-limited","benchmark":"CIS PostgreSQL","section":"4.x","title":"REPLICATION attribute limited","severity":"medium","query":"SELECT rolname FROM pg_roles WHERE rolreplication AND rolname NOT IN ('postgres') AND rolname NOT LIKE 'pg_%'","expect":{"op":"rowsZero"},"remediation":"ALTER ROLE <r> NOREPLICATION; — replication can stream all data.","refs":["CIS PostgreSQL §4"] },
    { "engine":"postgresql","check_id":"pg-bypassrls-role-limited","benchmark":"CIS PostgreSQL","section":"4.x","title":"BYPASSRLS attribute limited","severity":"medium","query":"SELECT rolname FROM pg_roles WHERE rolbypassrls AND rolname NOT IN ('postgres') AND rolname NOT LIKE 'pg_%'","expect":{"op":"rowsZero"},"remediation":"ALTER ROLE <r> NOBYPASSRLS; — it ignores row-level security.","refs":["CIS PostgreSQL §4"] }
  ]
}
