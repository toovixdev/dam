{
  "pack": "CIS MySQL core (toward full automatable coverage)",
  "checks": [
    { "engine":"mysql","check_id":"mysql-repl-slave-priv","benchmark":"CIS MySQL 8.0","section":"8.x","title":"REPLICATION SLAVE privilege limited","severity":"low","query":"SELECT user, host FROM mysql.user WHERE Repl_slave_priv='Y' AND user NOT IN ('root','mysql.sys','mysql.session','mysql.infoschema')","expect":{"op":"rowsZero"},"remediation":"REVOKE REPLICATION SLAVE ON *.* FROM '<u>'@'<h>';","refs":["CIS MySQL 8.0 §8"] },
    { "engine":"mysql","check_id":"mysql-repl-client-priv","benchmark":"CIS MySQL 8.0","section":"8.x","title":"REPLICATION CLIENT privilege limited","severity":"low","query":"SELECT user, host FROM mysql.user WHERE Repl_client_priv='Y' AND user NOT IN ('root','mysql.sys','mysql.session','mysql.infoschema')","expect":{"op":"rowsZero"},"remediation":"REVOKE REPLICATION CLIENT ON *.* FROM '<u>'@'<h>';","refs":["CIS MySQL 8.0 §8"] },
    { "engine":"mysql","check_id":"mysql-event-priv","benchmark":"CIS MySQL 8.0","section":"8.x","title":"EVENT privilege limited","severity":"low","query":"SELECT user, host FROM mysql.user WHERE Event_priv='Y' AND user NOT IN ('root','mysql.sys','mysql.session','mysql.infoschema')","expect":{"op":"rowsZero"},"remediation":"REVOKE EVENT ON *.* FROM '<u>'@'<h>';","refs":["CIS MySQL 8.0 §8"] },
    { "engine":"mysql","check_id":"mysql-create-tablespace-priv","benchmark":"CIS MySQL 8.0","section":"8.x","title":"CREATE TABLESPACE privilege limited","severity":"medium","query":"SELECT user, host FROM mysql.user WHERE Create_tablespace_priv='Y' AND user NOT IN ('root','mysql.sys','mysql.session','mysql.infoschema')","expect":{"op":"rowsZero"},"remediation":"REVOKE CREATE TABLESPACE ON *.* FROM '<u>'@'<h>';","refs":["CIS MySQL 8.0 §8"] },
    { "engine":"mysql","check_id":"mysql-show-db-priv","benchmark":"CIS MySQL 8.0","section":"8.x","title":"SHOW DATABASES privilege limited","severity":"low","query":"SELECT user, host FROM mysql.user WHERE Show_db_priv='Y' AND user NOT IN ('root','mysql.sys','mysql.session','mysql.infoschema')","expect":{"op":"rowsZero"},"remediation":"REVOKE SHOW DATABASES ON *.* FROM '<u>'@'<h>';","refs":["CIS MySQL 8.0 §8"] },
    { "engine":"mysql","check_id":"mysql-secure-file-priv","benchmark":"CIS MySQL 8.0","section":"4.x","title":"secure_file_priv restricts file import/export","severity":"medium","query":"SHOW VARIABLES LIKE 'secure_file_priv'","expect":{"op":"notEmpty","column":"Value"},"remediation":"Set secure_file_priv to a dedicated directory (empty = anywhere).","refs":["CIS MySQL 8.0 §4"] },
    { "engine":"mysql","check_id":"mysql-general-log-off","benchmark":"CIS MySQL 8.0","section":"6.x","title":"general_log is off","severity":"low","query":"SHOW VARIABLES LIKE 'general_log'","expect":{"op":"equals","column":"Value","value":"OFF"},"remediation":"SET GLOBAL general_log=OFF; — the general log records plaintext statements.","refs":["CIS MySQL 8.0 §6"] },
    { "engine":"mysql","check_id":"mysql-default-auth-plugin","benchmark":"CIS MySQL 8.0","section":"5.x","title":"default_authentication_plugin is caching_sha2_password","severity":"medium","query":"SHOW VARIABLES LIKE 'default_authentication_plugin'","expect":{"op":"equals","column":"Value","value":"caching_sha2_password"},"remediation":"Set default_authentication_plugin=caching_sha2_password.","refs":["CIS MySQL 8.0 §5"] },
    { "engine":"mysql","check_id":"mysql-binlog-encryption","benchmark":"CIS MySQL 8.0","section":"6.x","title":"binlog_encryption is ON","severity":"medium","query":"SHOW VARIABLES LIKE 'binlog_encryption'","expect":{"op":"equals","column":"Value","value":"ON"},"remediation":"SET PERSIST binlog_encryption=ON; — encrypts binary/relay logs at rest.","refs":["CIS MySQL 8.0 §6","PCI-DSS 3.4"] },
    { "engine":"mysql","check_id":"mysql-redo-log-encryption","benchmark":"CIS MySQL 8.0","section":"6.x","title":"innodb_redo_log_encrypt is ON","severity":"medium","query":"SHOW VARIABLES LIKE 'innodb_redo_log_encrypt'","expect":{"op":"equals","column":"Value","value":"ON"},"remediation":"SET PERSIST innodb_redo_log_encrypt=ON;","refs":["CIS MySQL 8.0 §6","PCI-DSS 3.4"] },
    { "engine":"mysql","check_id":"mysql-undo-log-encryption","benchmark":"CIS MySQL 8.0","section":"6.x","title":"innodb_undo_log_encrypt is ON","severity":"medium","query":"SHOW VARIABLES LIKE 'innodb_undo_log_encrypt'","expect":{"op":"equals","column":"Value","value":"ON"},"remediation":"SET PERSIST innodb_undo_log_encrypt=ON;","refs":["CIS MySQL 8.0 §6"] },
    { "engine":"mysql","check_id":"mysql-password-history","benchmark":"CIS MySQL 8.0","section":"5.x","title":"password_history is set (reuse prevention)","severity":"low","query":"SHOW VARIABLES LIKE 'password_history'","expect":{"op":"notEquals","column":"Value","value":"0"},"remediation":"SET PERSIST password_history=6;","refs":["CIS MySQL 8.0 §5","PCI-DSS 8.3.7"] },
    { "engine":"mysql","check_id":"mysql-password-reuse-interval","benchmark":"CIS MySQL 8.0","section":"5.x","title":"password_reuse_interval is set","severity":"low","query":"SHOW VARIABLES LIKE 'password_reuse_interval'","expect":{"op":"notEquals","column":"Value","value":"0"},"remediation":"SET PERSIST password_reuse_interval=365;","refs":["CIS MySQL 8.0 §5"] },
    { "engine":"mysql","check_id":"mysql-password-require-current","benchmark":"CIS MySQL 8.0","section":"5.x","title":"password_require_current is ON","severity":"low","query":"SHOW VARIABLES LIKE 'password_require_current'","expect":{"op":"equals","column":"Value","value":"ON"},"remediation":"SET PERSIST password_require_current=ON;","refs":["CIS MySQL 8.0 §5"] }
  ]
}
